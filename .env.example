# Copia este archivo a .env y reemplaza los valores. Nunca subas .env al repo.

# Base de datos
POSTGRES_DB=clinica_db
POSTGRES_USER=clinica
POSTGRES_PASSWORD=cambia-esta-password

# JWT: clave Base64 de al menos 256 bits. Generar con: openssl rand -base64 64
JWT_SECRET=reemplaza-con-salida-de-openssl-rand-base64-64
JWT_EXPIRATION_MS=86400000

# Opcional: si se define, al primer arranque se crea el usuario "admin" con esta password
ADMIN_INITIAL_PASSWORD=
